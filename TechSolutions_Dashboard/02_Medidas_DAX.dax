// =====================================================================
// TechSolutions S.A.S. - Medidas DAX
// Power BI Desktop > Vista de informe > Inicio > Nueva medida
// Crea cada medida por separado (copia desde "Nombre =" hasta antes de la siguiente).
// Tabla de origen: Ventas
// =====================================================================

// ---------- KPI principales ----------
Total Ingresos = SUM ( Ventas[Total de ventas] )

Unidades Totales = SUM ( Ventas[Unidades] )

Productos Distintos = DISTINCTCOUNT ( Ventas[Producto] )

Promedio por Producto =
DIVIDE ( [Total Ingresos], [Productos Distintos] )

// ---------- Apoyo para la tabla y el análisis ----------
Promedio por Transacción =
DIVIDE ( [Total Ingresos], COUNTROWS ( Ventas ) )

% Participación =
DIVIDE (
    [Total Ingresos],
    CALCULATE ( [Total Ingresos], ALLSELECTED ( Ventas ) )
)

Ranking Vendedor =
RANKX ( ALLSELECTED ( Ventas[Vendedor] ), [Total Ingresos], , DESC )

// ---------- Tarjetas "Mejor ..." (responden la Fase 4) ----------
Producto Top =
VAR _t =
    TOPN ( 1, SUMMARIZE ( Ventas, Ventas[Producto], "v", [Total Ingresos] ), [v], DESC )
RETURN MAXX ( _t, Ventas[Producto] )

Categoría Top =
VAR _t =
    TOPN ( 1, SUMMARIZE ( Ventas, Ventas[Categoría], "v", [Total Ingresos] ), [v], DESC )
RETURN MAXX ( _t, Ventas[Categoría] )

Ciudad Top =
VAR _t =
    TOPN ( 1, SUMMARIZE ( Ventas, Ventas[Ciudad], "v", [Total Ingresos] ), [v], DESC )
RETURN MAXX ( _t, Ventas[Ciudad] )

Vendedor Top =
VAR _t =
    TOPN ( 1, SUMMARIZE ( Ventas, Ventas[Vendedor], "v", [Total Ingresos] ), [v], DESC )
RETURN MAXX ( _t, Ventas[Vendedor] )

// ---------- Formato recomendado (Herramientas de medida > Formato) ----------
// Total Ingresos, Promedio por Producto, Promedio por Transacción:  Moneda  $ #,##0
// Unidades Totales, Productos Distintos:                            Número entero
// % Participación:                                                  Porcentaje (1 decimal)
// Resultados esperados con los 10 registros del caso:
//   Total Ingresos 36.320.000 | Unidades 114 | Productos 6 | Promedio por producto 6.053.333
